{
  "datasets": [
    {
      "name": "3cc99003",
      "displayName": "Location Data",
      "queryLines": [
        "select latitude, longitude, `GHG emissions mtons CO2e`\n",
        "from emissions_data\n"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "12f72ece",
      "displayName": "Emissions Per Person",
      "queryLines": [
        "SELECT county_state_name,\n",
        "       SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions_mtons,\n",
        "       population,\n",
        "       ROUND(SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) / population, 4) AS emissions_per_person\n",
        "FROM emissions_data\n",
        "GROUP BY county_state_name, population\n",
        "ORDER BY emissions_per_person DESC\n",
        "\n"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "85c2a03a",
      "displayName": "Total Emissions Per State",
      "queryLines": [
        "SELECT state_abbr,\n",
        "       SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS Total_Emissions\n",
        "FROM emissions_data\n",
        "GROUP BY state_abbr\n",
        "ORDER BY Total_Emissions DESC\n",
        "LIMIT 10"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "2370e02f",
      "displayName": "County Population",
      "queryLines": [
        "SELECT county_state_name,\n",
        "       population,\n",
        "       CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS Total_Emissions\n",
        "FROM emissions_data\n",
        "ORDER BY Total_Emissions DESC\n",
        "LIMIT 10"
      ]
    }
  ],
